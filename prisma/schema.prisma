// School SaaS — Prisma Schema
// Multi-tenant school management platform (Emerson branded)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// PLATFORM LEVEL (controlled by Super Admin)
// ============================================

model PlatformPlan {
  id           String   @id @default(cuid())
  name         String   // Starter, Growth, Pro, Enterprise
  slug         String   @unique
  monthlyPrice Int      // in PKR
  studentLimit Int      // -1 = unlimited
  features     String   // JSON string of feature flags
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schools       School[]
  subscriptions Subscription[]
}

model School {
  id          String   @id @default(cuid())
  name        String
  city        String
  email       String?
  phone       String?
  address     String?
  planId      String
  plan        PlatformPlan @relation(fields: [planId], references: [id])
  status      String   @default("trial") // trial, active, suspended, deleted
  studentCount Int     @default(0)
  schoolCode  String?  // short code for Admission ID: e.g., BSS, TCS
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  users        User[]
  auditLogs    AuditLog[]
  settings     SchoolSettings?
  notices      Notice[]
  exams        Exam[]

  @@index([planId])
  @@index([status])
}

model Subscription {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId    String
  plan      PlatformPlan @relation(fields: [planId], references: [id])
  startDate DateTime
  endDate   DateTime?
  status    String   @default("active") // active, expired, cancelled
  amount    Int      // in PKR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  action    String   // school.create, school.suspend, school.activate, plan.assign, etc.
  entity    String   // school, plan, user
  entityId  String?
  metadata  String?  // JSON string of additional data
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
}

// ============================================
// USERS (Super Admin + School Users)
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          String   @default("SUPER_ADMIN") // SUPER_ADMIN, SCHOOL_ADMIN, PRINCIPAL, ACCOUNTANT, ADMISSION_OFFICER, TEACHER, PARENT, STUDENT
  schoolId      String?
  school        School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs      AuditLog[]
  notices        Notice[]
  leaveRequests  LeaveRequest[]
  approvedLeaves LeaveRequest[] @relation("LeaveApprover")
  parentStudents ParentStudent[]

  @@index([schoolId])
  @@index([role])
}

// ============================================
// SCHOOL CORE (Phase 2 — placeholder)
// ============================================

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  year      String   // 2024-25
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  exams       Exam[]

  @@index([schoolId])
}

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  campusId  String?
  name      String   // Class 1, Class 5, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  Section[]
  feePlans  FeePlan[]
  examMarks ExamMark[] @relation("ExamMarkClass")

  @@index([schoolId])
}

model Section {
  id        String   @id @default(cuid())
  classId   String
  name      String   // A, B, C
  capacity  Int      @default(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  examMarks   ExamMark[]   @relation("ExamMarkSection")

  @@index([classId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   // Mathematics, English
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examMarks ExamMark[]

  @@index([schoolId])
}

model Student {
  id          String   @id @default(cuid())
  schoolId    String
  admissionId String?  @unique
  name        String
  fatherName  String?
  dob         DateTime?
  gender      String? // male, female
  contact     String?
  address     String?
  status      String   @default("active") // active, graduated, left
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  attendances Attendance[]
  invoices    Invoice[]
  guardians   Guardian[]
  parents     ParentStudent[] @relation("ParentStudents")
  examMarks   ExamMark[]

  @@index([schoolId])
}

model Enrollment {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  sectionId      String
  rollNo         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section        Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
  invoices       Invoice[]

  @@index([studentId])
  @@index([sectionId])
}

model Guardian {
  id        String   @id @default(cuid())
  studentId String
  name      String
  phone    String?
  email    String?
  relation String? // father, mother, guardian
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Attendance {
  id           String   @id @default(cuid())
  enrollmentId String
  studentId    String
  date         DateTime
  status       String   // present, absent, late, leave
  markedBy     String?
  createdAt    DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([studentId])
  @@index([date])
}

// ============================================
// FEES & BILLING (Phase 2 — placeholder)
// ============================================

model FeePlan {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String?
  title     String   // Monthly Tuition, Admission Fee
  amount    Int      // in PKR
  frequency String   // monthly, quarterly, yearly, one_time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class    Class?  @relation(fields: [classId], references: [id])
  invoices Invoice[]

  @@index([schoolId])
}

model Invoice {
  id           String   @id @default(cuid())
  enrollmentId String
  studentId    String
  feePlanId    String?
  month        DateTime?
  amount       Int
  dueDate      DateTime
  status       String   @default("unpaid") // unpaid, partial, paid, overdue, cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feePlan    FeePlan?   @relation(fields: [feePlanId], references: [id])
  payments   Payment[]

  @@index([studentId])
  @@index([status])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Int
  method    String   // cash, bank, jazzcash, easypaisa
  receiptNo String?
  paidAt    DateTime @default(now())
  notes     String?

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ============================================
// PHASE R2 — EXAMS, MARKS, PARENT-STUDENT LINK
// ============================================

model Exam {
  id           String   @id @default(cuid())
  schoolId     String
  academicYearId String
  name         String   // Mid-Term, Final, Monthly Test 1
  term         String   // mid_term, final, monthly
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  marks        ExamMark[]

  @@index([schoolId])
  @@index([academicYearId])
}

model ExamMark {
  id           String   @id @default(cuid())
  examId       String
  studentId    String
  subjectId    String
  classId      String
  sectionId    String
  marks        Int      // obtained
  totalMarks   Int      // out of
  grade        String?  // A+, A, B, C, D, F
  remarks      String?
  enteredBy    String
  status       String   @default("submitted") // draft, submitted, approved
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id])
  class    Class    @relation("ExamMarkClass", fields: [classId], references: [id])
  section  Section  @relation("ExamMarkSection", fields: [sectionId], references: [id])

  @@unique([examId, studentId, subjectId])
  @@index([examId])
  @@index([studentId])
  @@index([sectionId])
}

model ParentStudent {
  parentId    String
  studentId   String
  relation    String   @default("father") // father, mother, guardian
  createdAt   DateTime @default(now())

  parent   User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student  Student  @relation("ParentStudents", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
}

// ============================================
// PHASE 3 — SCHOOL SETTINGS, NOTICES, LEAVES
// ============================================

model SchoolSettings {
  schoolId                  String   @id
  defaultersReminderDays    Int      @default(5)
  defaultersLateFee         Int      @default(0)
  defaultersPortalBlockDays Int      @default(30)
  defaultersSuspendDays     Int      @default(60)
  smsEnabled                Boolean  @default(false)
  whatsappEnabled           Boolean  @default(false)
  studentLoginMinClass      String   @default("Class 6")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Notice {
  id          String   @id @default(cuid())
  schoolId    String
  postedBy    String
  title       String
  body        String
  noticeType  String   @default("school_wide") // school_wide, branch_wide, class_specific
  classId     String?
  sendSms     Boolean  @default(false)
  createdAt   DateTime @default(now())

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  poster    User     @relation(fields: [postedBy], references: [id])

  @@index([schoolId])
  @@index([createdAt])
}

model LeaveRequest {
  id              String   @id @default(cuid())
  userId          String
  schoolId        String
  startDate       DateTime
  endDate         DateTime
  type            String   // casual, sick, emergency, maternity
  reason          String
  status          String   @default("pending") // pending, approved, rejected
  approvedBy      String?
  approverComment String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver   User?    @relation("LeaveApprover", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([schoolId])
  @@index([status])
}
